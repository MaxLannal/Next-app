{
  "name": "personal-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently \"node --watch server/main.ts\" \"vite web\"",
