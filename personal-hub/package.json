    "@tanstack/react-query": "^5.108.3",
    "date-fns": "^4.4.0",
    "hono": "^4.13.20",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
